# Client-visible feature gate only — never put secrets in VITE_* variables.
# Leave false until Netlify Identity is invite-only and the first administrator is ready.
VITE_ADMIN_AUTH_ENABLED=false

# Server-only flags (set in Netlify UI → Environment variables, not committed):
# ADMIN_AUTH_ENABLED=true
# ADMIN_EMAIL_ALLOWLIST=stellaroskens@gmail.com
# GITHUB_CONTENT_TOKEN=github_pat_...   # repo contents:write; never VITE_* / never browser
# GITHUB_CONTENT_OWNER=stellaroskens
# GITHUB_CONTENT_REPO=WAHSB
# GITHUB_CONTENT_BRANCH=main
